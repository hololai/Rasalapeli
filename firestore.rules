rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Apufunktiot oikeuksien tarkistamiseen
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isSuperAdmin() {
      return request.auth.token.email == 'heikki.laivamaa@gmail.com' || getRole() == 'superadmin';
    }
    function isAdmin() {
      return getRole() == 'admin';
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /map_locations/{document} {
      allow read: if request.auth != null && getRole() != 'pending';
      allow write: if request.auth != null && (isSuperAdmin() || isAdmin());
    }

    match /images/{imageId} {
      allow read: if request.auth != null && getRole() != 'pending';
      allow update: if request.auth != null && (isSuperAdmin() || isAdmin());
      allow create, delete: if request.auth != null && (isSuperAdmin() || isAdmin());
      
      match /comments/{commentId} {
        allow read: if request.auth != null && getRole() != 'pending';
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && (isSuperAdmin() || isAdmin());
      }
    }

    match /quiz_questions/{questionId} {
      allow read: if request.auth != null && getRole() != 'pending';
      allow write: if request.auth != null && (isSuperAdmin() || isAdmin());
    }

    function isPredefinedAdmin(email) {
      return email in [
        'hannulaivamaa@gmail.com',
        'helenalaivalahti@gmail.com',
        'juhaville.laivamaa@gmail.com',
        'markkulaivamaa7@gmail.com',
        'outi.myllarinen@gmail.com',
        'perttu.laivamaa@gmail.com',
        'tiina.ilmanen@gmail.com',
        'katariina.laivamaa@gmail.com'
      ];
    }

    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId && 
                    (request.resource.data.role == 'pending' || 
                    (request.auth.token.email != null && (
                      (request.resource.data.role == 'superadmin' && request.auth.token.email == 'heikki.laivamaa@gmail.com') ||
                      (request.resource.data.role == 'admin' && isPredefinedAdmin(request.auth.token.email))
                    )));
      allow read: if request.auth != null && (request.auth.uid == userId || isSuperAdmin() || isAdmin());
      
      // OMAN PROFIILIN PÄIVITYS: Käyttäjä saa päivittää omia tietojaan (esim. suosikit),
      // kunhan hän ei yritä muuttaa omaa rooliaan!
      allow update: if request.auth != null && request.auth.uid == userId && 
                    request.resource.data.role == resource.data.role;
      // SUPERADMIN SÄÄNTÖ: saa tehdä mitä vain muiden profiileille
      allow update, delete: if request.auth != null && isSuperAdmin();

      // ADMIN SÄÄNTÖ: saa päivittää tai poistaa profiileja, jos:
      // 1. Kohdekäyttäjä on 'user' tai 'pending' (ei kosketa admineita/superadmineita)
      // 2. Ei yritä asettaa rooliksi 'admin' tai 'superadmin' (estetään itsensä ylentäminen)
      allow update: if request.auth != null && isAdmin() &&
                    (resource.data.role == 'user' || resource.data.role == 'pending') &&
                    (request.resource.data.role == 'user' || request.resource.data.role == 'pending');
                    
      allow delete: if request.auth != null && isAdmin() &&
                    (resource.data.role == 'user' || resource.data.role == 'pending');
    }
  }
}
